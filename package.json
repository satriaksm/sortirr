{
  "name": "sortirr",
  "version": "1.0.0",
  "description": "Universal Smart File Sorter",
  "main": "main.js",
  "author": "satriaksm",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win",
    "dist:setup": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.satriaksm.sortirr",
    "productName": "Sortirr",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!.git/**/*",
      "!.trash/**/*",
      "!.cache/**/*",
      "!public/dump/**/*",
      "!public/Family/**/*",
      "!public/MAN/**/*",
      "!public/Musik/**/*",
      "!public/SD/**/*",
      "!public/Sumbing/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sortirr"
    },
    "portable": {
      "artifactName": "Sortirr-${version}-Portable.exe"
    }
  }
}
